FROM ghcr.io/edera-dev/cross-base-linux-musl:latest@sha256:c77755828c07d2d261b6a48388e3daa00aa3482b26eceb67dfc989e5286f1901 AS build

ENV TARGET_LIBC=musl TARGET_VENDOR=unknown DISABLE_CROSS_RS=1

WORKDIR /usr/src/app
COPY . .
RUN ./hack/build/cargo.sh build --release --bin edera-check
RUN mv ./target/$(./hack/build/target.sh)/release/edera-check /usr/sbin

FROM cgr.dev/chainguard/wolfi-base:latest
ENTRYPOINT ["/usr/sbin/edera-check"]
COPY --from=build /usr/sbin/edera-check /usr/sbin/edera-check
